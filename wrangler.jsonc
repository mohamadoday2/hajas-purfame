{
  // The Worker name must be exactly the same as the project name in the Cloudflare dashboard
  "name": "hajas-parfums",
  "main": "./public/_worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // only these paths run the order system code; everything else is the static site
    "run_worker_first": ["/api/*", "/admin", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajas-orders",
      "database_id": "ff23446d-6150-4690-b60c-e68703dc4a68"
    }
  ]
}
